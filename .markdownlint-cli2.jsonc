{
  "config": {
    // 中文文档按语义分段，不按行长换行
    "MD013": false,
    // 允许在文档中使用 HTML（表格微调、折叠块等）
    "MD033": false,
    // 参考文献等合集文档允许非标题开头
    "MD041": false,
    // 不同章节允许重复的子标题
    "MD024": { "siblings_only": true },
    // 中文列表前后常有全角标点，关闭过严的标点规则
    "MD026": false,
    // 标题/列表不强制周围空行（中文排版习惯，GitHub 渲染无差异）
    "MD022": false,
    "MD032": false,
    // 报告模板刻意包含两个一级标题（文件标题 + 模板正文标题）
    "MD025": false,
    // 样例报告的连续引用块刻意用空行分隔
    "MD028": false,
    // 来源清单代码块刻意不标语言
    "MD040": false,
    // `[n]` 是引用编号格式，不是 markdown 引用链接
    "MD052": false,
    // 表格对齐风格不强制（中文字符宽度导致按字节对齐不可行）
    "MD060": false
  }
}
